+// WriteMultiBuffer admits an operation under the session lock, then releases
+// it before I/O. Close prevents new admissions; the response owner joins the
+// accepted writes before detaching observation segments.
+func (s *Session) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	s.parent.RLock()
+	if s.closed {
+		s.parent.RUnlock()
+		buf.ReleaseMulti(mb)
+		return io.ErrClosedPipe
+	}
+	s.historyWriters.Add(1)
+	s.parent.RUnlock()
+	defer s.historyWriters.Done()
+	return s.output.WriteMultiBuffer(mb)
+}
