variable "region" {
  type    = string
  default = "ap-northeast-2"
}

variable "my_ip_cidr" {
  type        = string
  description = "Operator public IP as a /32 CIDR; the only source allowed to SSH."
  validation {
    condition     = can(regex("/32$", var.my_ip_cidr))
    error_message = "my_ip_cidr must be a single address, e.g. 203.0.113.7/32."
  }
}

variable "ssh_public_key" {
  type        = string
  description = "Public key for the throwaway key pair (generated by run.sh)."
}

variable "instance_type" {
  type    = string
  default = "t3.small"
}

variable "name_prefix" {
  type    = string
  default = "proxima-e2e"
}
